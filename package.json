{
  "name": "pupitre-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter pupitre dev",
    "dev:debug": "pnpm --filter pupitre dev:debug",
    "dev:web": "pnpm --filter pupitre dev:web",
    "build": "pnpm --filter pupitre build",
    "build:web": "pnpm --filter pupitre build:web",
    "dist": "pnpm --filter pupitre dist",
    "test": "pnpm --filter pupitre test",
    "test:coverage": "pnpm --filter pupitre test:coverage",
    "test:e2e": "pnpm --filter pupitre test:e2e",
    "test:perf": "pnpm --filter pupitre test:perf",
    "bench": "pnpm --filter pupitre bench",
    "perf:fixtures": "pnpm --filter pupitre perf:fixtures",
    "check:bundle": "pnpm --filter pupitre check:bundle",
    "typecheck": "pnpm --filter pupitre typecheck",
    "lint": "oxfmt --check . && oxlint --type-aware . && pnpm --filter pupitre check:css && pnpm --filter pupitre check:architecture",
    "knip": "knip",
    "fix": "oxfmt . && oxlint --fix .",
    "check:css": "pnpm --filter pupitre check:css",
    "check:architecture": "pnpm --filter pupitre check:architecture"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "knip": "^6.43.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.9"
}
