{
  "name": "pupitre",
  "version": "0.3.0",
  "description": "A markdown editor",
  "license": "MIT",
  "author": "shalemore",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
