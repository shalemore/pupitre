{
  "name": "pupitre",
  "version": "0.8.1",
  "description": "A markdown editor",
  "homepage": "https://github.com/shalemore/pupitre",
  "license": "MIT",
  "author": {
    "name": "shalemore",
    "url": "https://github.com/shalemore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalemore/pupitre.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9222",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "offstage-windows playwright test --config=playwright.perf.config.ts",
    "bench": "vitest bench --config=vitest.bench.config.ts --run --reporter=verbose",
    "perf:fixtures": "node scripts/perf-fixtures.ts",
    "check:bundle": "node scripts/check-bundle-size.ts",
    "postinstall": "patch-package",
    "typecheck": "tsrs -b",
    "lint": "oxfmt --check . && oxlint --type-aware . && node scripts/check-css.ts",
    "knip": "knip",
    "fix": "oxfmt . && oxlint --fix .",
    "check:css": "node scripts/check-css.ts"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/fuses": "^1.8.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@kobalte/core": "^0.13.14",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "1.8.1",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@solid-primitives/event-listener": "^2.4.6",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/scheduled": "^1.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "@types/write-file-atomic": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "commonmark-spec": "^0.31.2",
    "direction": "^2.0.1",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "fast-check": "^4.10.2",
    "gemoji": "^8.1.0",
    "iconv-lite": "^0.7.3",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lucide-solid": "^1.16.0",
    "mermaid": "^12.2.0",
    "offstage-windows": "^0.1.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "^7.0.2005",
    "p-limit": "^7.3.3",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.64.1",
    "pretty-bytes": "^7.2.0",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.3.3",
    "tsrs": "^0.20.0-ts7.1.0-beta",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^5.0.5",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "productName": "Pupitre"
}
