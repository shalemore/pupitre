{
  "name": "pupitre",
  "version": "0.7.1",
  "description": "A markdown editor",
  "homepage": "https://github.com/shalemore/pupitre",
  "license": "MIT",
  "author": {
    "name": "shalemore",
    "url": "https://github.com/shalemore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalemore/pupitre.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9222",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:web": "vite build --config vite.web.config.ts",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc -b",
    "lint": "oxfmt --check . && oxlint . && node scripts/import-order.mjs --check",
    "fix": "oxfmt . && oxlint --fix . && node scripts/import-order.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@kobalte/core": "^0.13.14",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@solid-primitives/event-listener": "^2.4.6",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/scheduled": "^1.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "direction": "^2.0.1",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "gemoji": "^8.1.0",
    "iconv-lite": "^0.7.3",
    "lucide-solid": "^1.16.0",
    "mathjax-full": "^3.2.2",
    "mermaid": "^12.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "^1.16.0",
    "playwright-core": "^1.64.1",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vite-plugin-solid": "^2.11.6"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "productName": "Pupitre"
}
