{
  "$schema": "./node_modules/knip/schema.json",
  // The electron-vite, Vite, Vitest and Playwright plugins read their own configs, so the entries
  // they cannot see are the ones listed here.
  "entry": [
    // `npm run test:perf` runs this config; the Playwright plugin only reads playwright.config.ts
    "playwright.perf.config.ts",
  ],
  "ignoreBinaries": [
    // A Linux system tool: src/main/windows.ts reads where the desktop puts the caption buttons
    "gsettings",
  ],
  "ignoreDependencies": [
    // Drives the built app from throwaway scripts outside the repo, which is how a UI change is
    // checked by hand (AGENTS.md); no file in the tree imports it on purpose
    "playwright-core",
  ],
  "ignoreIssues": {
    // The IPC contract: the types are what a host implements and a window calls with, so they stay
    // exported for those who write against it
    "src/shared/desktop-api.ts": ["types"],
    // The ui barrel is a public boundary: a primitive's option type is exported for its callers
    "src/renderer/components/ui/segmented-control.tsx": ["types"],
  },
}
