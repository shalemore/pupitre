{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@root/*": ["./*"],
      "@agents/*": ["../../agents/*"]
    }
  },
  "references": [
    { "path": "../../packages/i18n" },
    { "path": "../../packages/settings" },
    { "path": "../../packages/desktop-api" },
    { "path": "../../packages/panda-preset" },
    { "path": "../../packages/utils" },
    { "path": "../../packages/markdown" },
    { "path": "../../packages/plugin-sdk" },
    { "path": "../../plugins/writing-modes" },
    { "path": "../../plugins/source-mode" },
    { "path": "../../packages/ui" }
  ],
  // The benchmark parses through the renderer's language, so it is checked with the DOM lib
  "include": ["src/renderer", "src/shared", "src/web", "bench"]
}
