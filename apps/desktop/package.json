{
  "name": "pupitre",
  "version": "0.10.0",
  "private": true,
  "description": "A markdown editor",
  "homepage": "https://github.com/shalemore/pupitre",
  "license": "MIT",
  "author": {
    "name": "shalemore",
    "url": "https://github.com/shalemore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalemore/pupitre.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9222",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "offstage-windows playwright test --config=playwright.perf.config.ts",
    "bench": "vitest bench --config=vitest.bench.config.ts --run --reporter=verbose",
    "perf:fixtures": "node scripts/perf-fixtures.ts",
    "check:bundle": "node scripts/check-bundle-size.ts",
    "typecheck": "tsrs -b",
    "check:css": "node scripts/check-css.ts",
    "check:architecture": "node scripts/check-architecture.ts",
    "prepare": "panda codegen"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "junk": "^4.0.1",
    "winattr": "^4.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/fuses": "^1.8.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@kobalte/core": "^0.13.14",
    "@lezer/common": "^1.5.4",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/preset-panda": "^2.4.0",
    "@pandacss/vite": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@pupitre/desktop-api": "workspace:*",
    "@pupitre/i18n": "workspace:*",
    "@pupitre/markdown": "workspace:*",
    "@pupitre/panda-preset": "workspace:*",
    "@pupitre/plugin-sdk": "workspace:*",
    "@pupitre/plugin-source-mode": "workspace:*",
    "@pupitre/plugin-writing-modes": "workspace:*",
    "@pupitre/settings": "workspace:*",
    "@pupitre/ui": "workspace:*",
    "@pupitre/utils": "workspace:*",
    "@solid-primitives/event-listener": "^3.0.0",
    "@solid-primitives/media": "^4.0.0",
    "@solid-primitives/scheduled": "^2.0.0",
    "@solidjs/web": "^2.0.3",
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "@types/write-file-atomic": "^4.0.3",
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/solid": "^0.1.0-beta.13",
    "@vitest/coverage-v8": "^5.0.5",
    "bezier-easing": "^3.2.0",
    "chokidar": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "fast-check": "^4.10.2",
    "iconv-lite": "^0.7.3",
    "jsdom": "^30.1.3",
    "lucide-solid": "^1.77.0",
    "move-file": "^4.1.0",
    "offstage-windows": "^0.1.2",
    "p-limit": "^7.3.3",
    "playwright-core": "^1.64.1",
    "pretty-bytes": "^7.2.0",
    "solid-js": "^2.0.3",
    "tsrs": "^0.20.0-ts7.1.0-beta",
    "turndown": "^7.2.4",
    "unicode-segmenter": "^0.17.3",
    "vite": "^8",
    "@solidjs/vite-plugin": "^3.0.1",
    "vitest": "^5.0.5",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0",
  "productName": "Pupitre"
}
