{
  "name": "@pupitre/plugin-sdk",
  "version": "0.1.0",
  "description": "The manifest, permissions, settings and surfaces a Pupitre plugin is written against",
  "keywords": [
    "markdown",
    "plugin",
    "pupitre"
  ],
  "homepage": "https://github.com/shalemore/pupitre",
  "license": "MIT",
  "author": {
    "name": "shalemore",
    "url": "https://github.com/shalemore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalemore/pupitre.git",
    "directory": "packages/plugin-sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./trusted": {
      "types": "./dist/trusted.d.ts",
      "import": "./src/trusted.ts"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./trusted": {
        "types": "./dist/trusted.d.ts",
        "import": "./dist/trusted.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tsconfig/strictest": "^2.0.8",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  }
}
